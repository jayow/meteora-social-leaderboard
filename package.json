{
  "name": "pool-party",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start -p ${PORT:-3000}",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "backfill:mints": "node scripts/backfill-mints.mjs",
    "backfill:badges": "tsx scripts/backfill-badges.ts",
    "postinstall": "npm run backfill:mints || echo 'Backfill optional'"
  },
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/wallet-standard-util": "^1.1.4",
    "@solana/web3.js": "^1.95.8",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.27",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "jayson": "^5.0.0",
    "@solflare-wallet/sdk": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
